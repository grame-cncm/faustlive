<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of FaustLive.app with the hardened runtime (required for notarization),
  used by Build/macos-sign-dmg.sh:
  - the LLVM JIT of libfaust writes and executes code at run time,
  - the DSPs with inputs read the microphone / audio input (NSMicrophoneUsageDescription).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
